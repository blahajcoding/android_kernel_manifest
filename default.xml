<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <remote name="aosp"
          fetch="https://android.googlesource.com/" />
  <remote name="github"
          fetch="https://github.com/" />
  <remote name="blahajcoding"
          fetch="https://github.com/blahajcoding/" />

  <default revision="main" remote="blahajcoding" sync-j="4" sync-c="true" />

  <!-- OnePlus 9 Pro (lemonadep, SM8350/Lahaina) on Android Common Kernel 6.18 -->
  <project name="lemonadep-6.18-kernel"
           path="kernel/lemonadep-6.18"
           revision="main"
           clone-depth="1" />

  <project name="lemonadep-6.18-modules"
           path="kernel/lemonadep-6.18-modules"
           revision="main"
           clone-depth="1" />

  <project name="lemonadep-6.18-devicetrees"
           path="kernel/lemonadep-6.18-devicetrees"
           revision="main"
           clone-depth="1" />
</manifest>
