<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <remote name="blahajcoding"
          fetch="https://github.com/blahajcoding/"
          clone-depth="1" />

  <default remote="blahajcoding"
           revision="lemonadep/initial-scaffold"
           sync-j="4"
           sync-c="true" />

  <!-- OnePlus 9 Pro (lemonadep, SM8350/Lahaina) on Android Common Kernel 6.18.
       The kernel build is self-contained: kernel/lemonadep-6.18/build.sh pins
       and downloads the Clang/Rust/bindgen/pahole/mkdtboimg/AnyKernel3 tools.
       The modules and devicetree repositories must remain siblings of the
       kernel checkout because build.sh links them into its work directory. -->
  <project path="kernel/lemonadep-6.18"
           name="lemonadep-6.18-kernel"
           clone-depth="1" />
  <project path="kernel/lemonadep-6.18-modules"
           name="lemonadep-6.18-modules"
           clone-depth="1" />
  <project path="kernel/lemonadep-6.18-devicetrees"
           name="lemonadep-6.18-devicetrees"
           clone-depth="1" />
</manifest>
